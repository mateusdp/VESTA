!
! Instruction file with global PFTs to be used with the
! CF I/O module.
!
! Make sure to start LPJ-GUESS with -input cf when using this
! instruction file.
!

import "global_p-traits-srlmyco_daily.ins"

!///////////////////////////////////////////////////////////////////////////////////////
! Forcing Data & gridlists
!

param "file_gridlist_cf" (str "./gridlist_60S_30S.txt")
param "file_gridlist" (str "./gridlist_60S_30S.txt")

param "file_co2"      (str "/gpfs/scratch/ehpc336/LPJ_GUESS/input/chelsa_bands/co2_1850-2100_sres_A1B.txt")

! N deposition (blank string to use constant pre-industrial level of 2 kgN/ha/year)
param "file_ndep"     (str "/gpfs/scratch/ehpc336/LPJ_GUESS/input/chelsa_bands/GlobalNitrogenDeposition.bin")

! P deposition
param "file_pdep"     (str "/gpfs/scratch/ehpc336/LPJ_GUESS/input/chelsa_bands/GlobalTSPPO4depLandMonthly.csv")

! P weathering
param "file_pwtr"     (str "/gpfs/scratch/ehpc336/LPJ_GUESS/input/chelsa_bands/lith_classes_shield_pdata_05.csv")

param "file_temp"     (str "/gpfs/scratch/ehpc336/LPJ_GUESS/input/chelsa_bands/temp_v2_60S_30S_reorder.nc")
param "variable_temp" (str "temp")

param "file_prec"     (str "/gpfs/scratch/ehpc336/LPJ_GUESS/input/chelsa_bands/prec_v2_60S_30S_reorder.nc")
param "variable_prec" (str "prec")

param "file_insol"      (str "/gpfs/scratch/ehpc336/LPJ_GUESS/input/chelsa_bands/rad_v2_60S_30S_reorder.nc")
param "variable_insol"  (str "insol")
!param "variable_insol"  (str "dswrf")

param "file_wind" (str "")
param "variable_wind"  (str "wind")

param "file_relhum" (str "")
param "variable_relhum"	(str "rhum")

! Needed if relative humidity is not supplied
param "file_pres"     (str "")
param "variable_pres" (str "")

! Needed if relative humidity is not supplied
param "file_specifichum" (str "")
param "variable_specifichum" (str "")

! Wet days can only be used with monthly precipitation
param "file_wetdays"     (str "")
param "variable_wetdays" (str "wetdays")

! Min/max temp is required for BVOC,
! if BVOC is switched off these can be set to ""
param "file_min_temp"      (str "")
param "variable_min_temp"  (str "min_temp")

param "file_max_temp"      (str "")
param "variable_max_temp"  (str "max_temp")

! SIMFIRE-BLAZE related files
param "file_simfire"  (str "/gpfs/scratch/ehpc336/LPJ_GUESS/input/chelsa_bands/SimfireInput.bin")

! Soil map
!param "file_soildata" (str "c:/soil/WISE/soilmap_wise.dat")
param "file_soildata" (str "/gpfs/scratch/ehpc336/LPJ_GUESS/input/chelsa_bands/soilmap_60S_30S.dat")

